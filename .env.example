# =============================================================================
# HARNESS CREDENTIALS (for running the autonomous agent harness)
# =============================================================================

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# AWS Credentials (choose one method)
# Method 1: Access keys
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-southeast-2

# Method 2: SSO/Profile (comment out access keys above)
# AWS_PROFILE=gazzwi86

# Slack App Credentials (for harness notifications)
# Get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# GitHub Personal Access Token
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...

# Context7 API Key
CONTEXT7_API_KEY=ctx7sk-...


# =============================================================================
# EXTERNAL SERVICE CREDENTIALS (must be provided - these exist outside AWS)
# =============================================================================

# -----------------------------------------------------------------------------
# Snowflake Data Warehouse
# -----------------------------------------------------------------------------
# These credentials connect to your existing Snowflake instance.
# Source of truth for employee roles, practices, allocations, absences.
SNOWFLAKE_ACCOUNT=your-account.ap-southeast-2.aws
SNOWFLAKE_USER=pixieops_service
SNOWFLAKE_PASSWORD=...
SNOWFLAKE_WAREHOUSE=PIXIEOPS_WH
SNOWFLAKE_DATABASE=WORKFORCE
SNOWFLAKE_SCHEMA=PUBLIC

# -----------------------------------------------------------------------------
# SharePoint (Employee Bio Source)
# -----------------------------------------------------------------------------
# These credentials connect to your existing SharePoint site.
# For Lambda extractor to pull employee bio documents.
SHAREPOINT_CLIENT_ID=...
SHAREPOINT_CLIENT_SECRET=...
SHAREPOINT_TENANT_ID=...
SHAREPOINT_SITE_URL=https://yourorg.sharepoint.com/sites/EmployeeBios


# =============================================================================
# INFRASTRUCTURE OUTPUTS (DO NOT SET MANUALLY)
# =============================================================================
# The following are created by Terraform and should NOT be set here.
# The agent will create these resources and manage their IDs via:
#   - Terraform outputs (infra/environments/dev/outputs.tf)
#   - Or a generated config file (e.g., generated_config.json)
#
# BEDROCK_KB_ID              <- Created by terraform module bedrock-kb
# BEDROCK_KB_DATA_SOURCE_ID  <- Created by terraform module bedrock-kb
# BEDROCK_GUARDRAIL_ID       <- Created by terraform module guardrails
# S3_VECTORS_BUCKET          <- Created by terraform module s3-vectors
# S3_VECTORS_INDEX           <- Created by terraform module s3-vectors
# S3_RAW_DOCS_BUCKET         <- Created by terraform module storage


# =============================================================================
# ENVIRONMENT SELECTION
# =============================================================================
AGENTCORE_ENVIRONMENT=dev
# AGENTCORE_ENVIRONMENT=prod
